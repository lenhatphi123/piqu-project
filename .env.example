# ============================================================================
# Biến môi trường (tuỳ chọn)
# ============================================================================
# App CHẠY ĐƯỢC mà không cần file .env. Chỉ tạo file .env khi bạn cần
# các tính năng bên dưới. Copy file này thành `.env` rồi điền giá trị:
#   cp .env.example .env
#
# Lưu ý: chỉ các biến có tiền tố VITE_ mới được đưa ra phía client.
# Sau khi sửa .env phải khởi động lại dev server.
# ============================================================================

# --- Google Maps (component client/src/components/Map.tsx) -------------------
# Không có 2 biến này, bản đồ sẽ không tải được (phần còn lại của app vẫn chạy).
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# --- Đăng nhập OAuth (client/src/const.ts -> getLoginUrl) -------------------
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# --- Analytics Umami (client/index.html) ------------------------------------
# Bỏ trống thì lúc build sẽ có cảnh báo "is not defined in env variables",
# đây chỉ là cảnh báo vô hại, không làm hỏng build.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- Storage proxy (chỉ dùng ở dev server, xem vite.config.ts) --------------
# Dùng cho route /manus-storage. KHÔNG có tiền tố VITE_ nên không lộ ra client.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Server production (server/index.ts) ------------------------------------
# Cổng cho `pnpm start`, mặc định 3000.
PORT=3000

# --- Firebase Admin SDK (server/firebase.ts, server/db.ts) ------------------
# Dữ liệu sản phẩm (kèm ảnh dạng base64) lưu trên Firestore.
# Cách lấy: Firebase Console > Project Settings > Service Accounts >
# Generate new private key (tải về 1 file JSON).
#
# Cách 1 (khuyên dùng khi deploy, ví dụ Vercel): dán NGUYÊN nội dung file JSON
# đó vào 1 dòng duy nhất, ví dụ:
#   FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"...", ...}
FIREBASE_SERVICE_ACCOUNT=

# Cách 2 (chạy local cho dễ đọc): tách 3 trường từ file JSON ra biến riêng.
# Lấy đúng giá trị "project_id", "client_email", "private_key" trong file JSON.
# Giữ nguyên các ký tự \n trong private_key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
